  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "description": "Acción principal de la tarea.",
      "html": "<button class=\"ds-primary\">Verificar respuesta</button>",
      "css": ".ds-primary{border:1px solid var(--linea-fuerte);background:var(--papel-alto);color:var(--tinta);padding:8px 14px;border-radius:var(--r);min-height:40px;font:550 13px var(--display);cursor:pointer;white-space:nowrap;background:var(--azul);border-color:var(--azul);color:var(--sobre-azul);}.ds-primary:hover:not(:disabled){background:var(--azul-fuerte);border-color:var(--azul-fuerte);}.ds-primary:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}.ds-primary:disabled{opacity:.42;cursor:not-allowed;}@media(max-width:700px){.ds-primary{min-height:44px;}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "description": "Acción auxiliar, como dibujar o adjuntar.",
      "html": "<button class=\"ds-secondary\">Dibujar en el editor</button>",
      "css": ".ds-secondary{border:1px solid var(--linea-fuerte);background:var(--papel-alto);color:var(--tinta);padding:8px 14px;border-radius:var(--r);min-height:40px;font:550 13px var(--display);cursor:pointer;white-space:nowrap;}.ds-secondary:hover:not(:disabled){background:var(--papel);border-color:var(--azul);}.ds-secondary:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}.ds-secondary:disabled{opacity:.42;cursor:not-allowed;}@media(max-width:700px){.ds-secondary{min-height:44px;}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Botón de texto",
      "kind": "button",
      "description": "Revelar ayuda o una solución bajo demanda.",
      "html": "<button class=\"ds-text\" aria-expanded=\"false\">Mostrar solución de referencia</button>",
      "css": ".ds-text{border:1px solid var(--linea-fuerte);background:var(--papel-alto);color:var(--tinta);padding:8px 14px;border-radius:var(--r);min-height:40px;font:550 13px var(--display);cursor:pointer;white-space:nowrap;background:transparent;border-color:transparent;color:var(--azul);padding:6px 11px;min-height:36px;font-size:12px;}.ds-text:hover{background:var(--papel);border-color:var(--azul);}.ds-text:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}@media(max-width:700px){.ds-text{min-height:44px;font-size:13px;}}",
      "refersTo": "button-text"
    },
    {
      "name": "Campo de respuesta",
      "kind": "input",
      "description": "Rótulo visible y notación mono.",
      "html": "<label class=\"ds-label\">Tu expresión regular<input class=\"ds-input\" placeholder=\"Por ejemplo: (a|b)*abb\" /></label>",
      "css": ".ds-label{display:flex;flex-direction:column;gap:7px;font:550 13px var(--display);color:var(--tinta);}.ds-input{min-height:42px;border:1px solid var(--linea-fuerte);border-radius:6px;padding:9px 11px;background:var(--papel-alto);color:var(--tinta);font:400 14px var(--mono);caret-color:var(--azul);}.ds-input::placeholder{color:var(--tinta-tenue);opacity:1;}.ds-input:focus{outline:2px solid var(--azul);outline-offset:-1px;border-color:var(--azul);}@media(max-width:700px){.ds-input{font-size:16px;}}",
      "refersTo": "input"
    },
    {
      "name": "Navegación principal",
      "kind": "nav",
      "description": "Navegación etiquetada con página actual.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><button aria-current=\"page\">Práctica</button><button>Parciales</button><button>Editor</button></nav>",
      "css": ".ds-nav{display:flex;gap:4px;overflow-x:auto;}.ds-nav button{flex:0 0 auto;border:0;background:none;min-height:40px;padding:9px 14px;border-radius:var(--r);font:500 14px var(--display);color:var(--tinta-suave);cursor:pointer;}.ds-nav button:hover{background:var(--papel);color:var(--tinta);}.ds-nav button[aria-current]{background:var(--azul-suave);color:var(--azul);font-weight:600;}.ds-nav button:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}@media(max-width:700px){.ds-nav button{min-height:44px;font-size:13px;}}",
      "refersTo": "nav-active"
    },
    {
      "name": "Puntos de práctica",
      "kind": "nav",
      "description": "Selección de punto con identificación y cantidad.",
      "html": "<nav class=\"ds-topics\" aria-label=\"Puntos de la práctica\"><button aria-current=\"page\"><span>A</span>Autómatas<small>12</small></button><button><span>F</span>LISP<small>8</small></button></nav>",
      "css": ".ds-topics{display:flex;gap:6px;overflow-x:auto;}.ds-topics button{display:flex;align-items:center;gap:8px;min-height:44px;padding:9px 14px;border:1px solid var(--linea);border-radius:6px;background:var(--papel-alto);color:var(--tinta);font:400 14px var(--display);cursor:pointer;white-space:nowrap;}.ds-topics span{font:12px var(--mono);color:var(--tinta-suave);}.ds-topics small{font-size:11px;color:var(--tinta-suave);margin-left:3px;}.ds-topics button[aria-current]{background:var(--azul);border-color:var(--azul);color:var(--sobre-azul);}.ds-topics button[aria-current] span,.ds-topics button[aria-current] small{color:inherit;}.ds-topics button:hover:not([aria-current]){border-color:var(--azul);}.ds-topics button:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}",
      "refersTo": "topic-active"
    },
    {
      "name": "Chapa de verificación",
      "kind": "chip",
      "description": "Estado expresado con texto y color.",
      "html": "<span class=\"ds-chip\">Verificado</span>",
      "css": ".ds-chip{display:inline-block;font:500 11px var(--mono);padding:2px 7px;border-radius:20px;border:1px solid var(--acepta);color:var(--acepta);background:var(--acepta-suave);white-space:nowrap;}",
      "refersTo": "chip-verified"
    },
    {
      "name": "Contenedor de diagrama",
      "kind": "card",
      "description": "Plano con borde para un diagrama o su tabla.",
      "html": "<div class=\"ds-diagram\"><svg viewBox=\"0 0 180 85\" role=\"img\" aria-label=\"Diagrama de un estado\"><circle cx=\"90\" cy=\"42\" r=\"25\"/><text x=\"90\" y=\"42\">q0</text></svg></div>",
      "css": ".ds-diagram{border:1px solid var(--linea);border-radius:var(--r);background:var(--papel-alto);padding:10px;max-width:320px;}.ds-diagram svg{display:block;width:100%;}.ds-diagram circle{fill:var(--papel-alto);stroke:var(--tinta-suave);stroke-width:1.4;}.ds-diagram text{font:500 13px var(--mono);fill:var(--tinta);text-anchor:middle;dominant-baseline:central;}",
      "refersTo": "diagram-panel"
    },
    {
      "name": "Selector móvil de ejercicio",
      "kind": "custom",
      "description": "Control plegable del banco; el contenido se resuelve en React.",
      "html": "<button class=\"ds-picker\" aria-expanded=\"false\" aria-controls=\"ds-bank\">Elegir ejercicio · A1<span>12 disponibles</span></button><div id=\"ds-bank\" hidden></div>",
      "css": ".ds-picker{display:flex;align-items:center;justify-content:space-between;gap:14px;width:100%;min-height:52px;border:0;padding:14px 20px;color:var(--azul);background:var(--papel);text-align:left;font:550 14px var(--display);cursor:pointer;}.ds-picker span{font-size:11px;font-weight:400;color:var(--tinta-suave);}.ds-picker:hover{color:var(--azul-fuerte);}.ds-picker:focus-visible {outline:2px solid var(--azul);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "Mesa de trabajo sobre papel",
    "overview": "AutómataLab conserva su mesa de trabajo de tinta azul y papel: una interfaz de operación, con controles precisos y una hoja de resolución como centro de atención. Space Grotesk sostiene la lectura y JetBrains Mono distingue expresiones, estados y cantidades. La densidad permite trabajar con enunciado, respuesta y diagrama sin convertir cada dato en una tarjeta.\n\nPráctica, Parciales y Mi progreso extienden el mismo sistema del editor. Los tonos Claro, Oscuro y Papel cambian los colores sin alterar la geometría; Sistema sigue la preferencia del dispositivo. El carácter es sobrio, legible y orientado a continuar una tarea.",
    "keyCharacteristics": [
      "Tinta azul para acciones y selección; color semántico acompañado por texto.",
      "Planos de papel separados por líneas finas y cambios de tono.",
      "Jerarquía de enunciado, resolución y comprobación; ayuda y solución bajo demanda.",
      "Paneles de trabajo en escritorio y hoja de una columna en teléfono."
    ],
    "rules": [
      {
        "name": "The Same Geometry Rule",
        "body": "Los temas cambian los colores, no las medidas, las familias tipográficas ni la posición de los controles.",
        "section": "colors"
      },
      {
        "name": "The Working Ink Rule",
        "body": "El azul identifica acciones y selección; aceptación, rechazo y advertencia conservan sus roles semánticos.",
        "section": "colors"
      },
      {
        "name": "The Flat Worksheet Rule",
        "body": "La hoja y los paneles permanecen planos; la elevación se reserva para herramientas y elementos que flotan sobre el lienzo.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar las variables compartidas de color y las dos familias tipográficas existentes.",
      "Do conservar el foco visible, los nombres accesibles y los estados escritos junto al color.",
      "Do mantener la respuesta al centro y las ayudas plegadas hasta que la persona las solicite.",
      "Do mostrar qué ejercicio y etapa reciben una copia del diagrama antes de guardarla.",
      "Do probar Claro, Oscuro, Papel y Sistema, además del flujo de una columna."
    ],
    "donts": [
      "Don't fijar blanco o negro en controles que deben adaptarse al tema.",
      "Don't presentar una solución de referencia como respuesta ya resuelta por el estudiante.",
      "Don't representar un diagrama del editor como adjunto hasta guardar explícitamente su copia.",
      "Don't usar solo un color para comunicar verificación, error o selección.",
      "Don't convertir los paneles funcionales en una colección de tarjetas con sombras decorativas."
    ]
  }
}
